npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock

# Build output
dist/
build/
.cache/
.next/
out/
coverage/
.env
.env.local
.env.*.local

# === Python ===
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
pip-wheel-metadata/
*.manifest
*.spec

# Distribution / packaging
build/
develop-eggs/
dist/
wheels/
*.egg-info/
.installed.cfg

# PyInstaller
*.manifest
*.spec

# Logs e temporários
*.log
*.tmp
*.bak
*.swp
*.swo

# Testes
.coverage
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# === IDEs & Editores ===
.vscode/
.idea/
*.code-workspace

# === Sistema Operacional ===
.DS_Store
Thumbs.db
desktop.ini

# === Ambiente local ===
.env
.env.test
.env.dev
.env.local
.env.production
.env.staging

# Arquivos de debug
*.pid
*.seed
*.pid.lock
